{
  "name": "testdummy",
  "version": "0.1.0",
  "description": "Chrome extension that fills forms with test data on local and staging sites",
  "main": "background.js",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "lint": "eslint . --ext .js",
    "test": "jest",
    "package": "cd dist && zip -r ../testdummy-extension.zip ."
  },
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "javascript",
    "web-extension"
  ],
  "author": "Corey Haines",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.1.2",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^27.0.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "axios": "^1.5.0"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/coreyhaines31/testdummy.git"
  },
  "homepage": "https://github.com/coreyhaines31/testdummy",
  "bugs": {
    "url": "https://github.com/coreyhaines31/testdummy/issues"
  }
}
